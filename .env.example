DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/flymasters
JWT_SECRET=change-me
API_PORT=8788

# Railway (required in production — set in Service → Variables):
# DATABASE_URL  → Postgres plugin → Connect → reference ${{Postgres.DATABASE_URL}}
# JWT_SECRET    → any long random string (e.g. openssl rand -hex 32)

# Optional: require this code when creating admin accounts (leave unset in local dev)
# ADMIN_SIGNUP_CODE=850065
# Set to true in production to allow open admin signup
# ADMIN_SIGNUP_OPEN=false

# Telecaller assignment: false (default) = admin manually assigns from Lead alerts.
# Set to true to auto-assign new leads to the least-loaded telecaller.
# TELECALLER_AUTO_ASSIGN=false
